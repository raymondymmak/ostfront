# Optional. With no key, the staff simulation runs the Russian side offline.
LLM_API_KEY=
# OpenAI-compatible base, without a trailing path beyond /v1.
LLM_BASE_URL=https://api.openai.com/v1
# Fast model. The chief of staff uses this. Prod may set z-ai/glm-5.3.
LLM_MODEL=gpt-4o-mini
# Optional stronger model for important Russian diplomacy turns. Not used by the advisor.
LLM_MODEL_STRONG=
# Per-call abort for the game master, in milliseconds. Default 45000. Clamped to 3000–50000.
# LLM_TIMEOUT_MS=45000
# Wall clock for both cascade calls, in milliseconds. Default 90000. Clamped to 3000–100000,
# and never shorter than LLM_TIMEOUT_MS. The turn and advisor functions allow 120s
# (Fluid Compute allows 300s on Hobby). The browser waits 130s, so the server answers first.
# GM_BUDGET_MS=90000
# Optional OpenRouter / provider headers (not required for OpenAI).
# LLM_HTTP_REFERER=https://your-site.example
# LLM_HTTP_TITLE=Ostfront 1915

# Turn API abuse protection (production with a live LLM key)
# TURN_MAX_BODY_BYTES=512000
# TURN_RATE_LIMIT_MAX=24
# TURN_RATE_LIMIT_WINDOW_MS=60000
# Comma-separated browser origins allowed to call POST /api/turn and POST /api/advisor without a token.
# TURN_ALLOWED_ORIGINS=https://ostfront-two.vercel.app,http://localhost:3000
# Optional shared secret; send as X-Ostfront-Turn-Token or Authorization: Bearer.
# TURN_API_TOKEN=

# Private Vercel Blob token. Each game-master and chief-of-staff response is stored
# under llm-log/ when this is set. When it is missing, logging is skipped.
# Create a Blob store on the Vercel project and connect it so Production receives this.
# BLOB_READ_WRITE_TOKEN=
